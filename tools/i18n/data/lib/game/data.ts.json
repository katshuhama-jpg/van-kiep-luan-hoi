 {
  "vi": "Kiếm tu",
  "en": "Sword Cultivator"
 },
 {
  "vi": "Kiếm",
  "en": "Sword"
 },
 {
  "vi": "Lấy kiếm nhập đạo. Công mạnh nhất, tu nhanh. Hay chết trận vì ham đánh.",
  "en": "Enter the Dao through the sword. Strongest attack, fast cultivation. Often dies in battle from loving a fight too much."
 },
 {
  "vi": "Đan tu",
  "en": "Alchemist"
 },
 {
  "vi": "Đan",
  "en": "Alchemy"
 },
 {
  "vi": "Sống lâu nhất trong các con đường. Luyện đan kiếm nhiều linh thạch, tự chế đan đột phá, tu nhanh hơn chút, có đan dược hộ thân nên khó chết, nhưng ra đòn không mạnh. Kiếp sau còn nhớ cách luyện: đan hồi hồn rẻ hơn 30%.",
  "en": "The longest-lived of all Paths. Alchemy earns plenty of spirit stones, you brew your own breakthrough pills, cultivate a little faster, and your pills keep you alive, but your strikes are weak. Next life you still remember the recipes: soul-return pills cost 30% less."
 },
 {
  "vi": "Trận tu",
  "en": "Formation Master"
 },
 {
  "vi": "Trận",
  "en": "Formation"
 },
 {
  "vi": "Bày trận, vẽ phù. Thủ cực chắc, bế quan an toàn, ít bị tập kích. Thường sống rất thọ.",
  "en": "Lay formations, draw talismans. Rock-solid defense, safe seclusion, rarely ambushed. Usually lives very long."
 },
 {
  "vi": "Phật tu",
  "en": "Buddhist Cultivator"
 },
 {
  "vi": "Phật",
  "en": "Buddhist"
 },
 {
  "vi": "Từ bi hỷ xả. Máu và thủ dày, thọ nguyên dài, tâm ma khó xâm nhập, đột phá vững vàng.",
  "en": "Compassion and equanimity. Thick HP and defense, long lifespan, heart demons find no way in, steady breakthroughs."
 },
 {
  "vi": "Ma tu",
  "en": "Demonic Cultivator"
 },
 {
  "vi": "Hút linh lực, luyện huyết công. Tu nhanh nhất, nhưng tâm ma cực nặng.",
  "en": "Drain spiritual power, refine blood arts. Fastest cultivation, but brutal heart demons."
 },
